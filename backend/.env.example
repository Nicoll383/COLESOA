# Servidor
PORT=3000
NODE_ENV=development

# MySQL - Base de datos relacional
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=colegio_soa_db
MYSQL_USER=colesoa_user
MYSQL_PASSWORD=tu_password_seguro

# MongoDB - Base de datos de documentos
MONGO_URI=mongodb://colesoa_user:tu_password_seguro@localhost:27017/colegio_soa_docs

# JWT - Autenticación
JWT_SECRET=tu_clave_secreta_muy_segura_cambiala_en_produccion
JWT_EXPIRES_IN=24h

# CORS
FRONTEND_URL=http://localhost:5173

# Uploads
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
