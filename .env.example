# Docker Compose Environment Variables

# Node Environment
NODE_ENV=production

# MySQL Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=colegio_soa_db
MYSQL_USER=colesoa_user
MYSQL_PASSWORD=colesoa_pass

# MongoDB Configuration
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=adminpassword
MONGO_DATABASE=colegio_soa_docs

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=24h

# Frontend URL
FRONTEND_URL=http://localhost:5173

# SMTP Configuration (Email Service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# File Upload Configuration
MAX_FILE_SIZE=5242880

# Application URLs
BACKEND_URL=http://localhost:3000
FRONTEND_URL_PUBLIC=http://localhost:5173
